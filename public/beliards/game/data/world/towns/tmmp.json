 "npcs": [
  {
   "index": 0,
   "raw": "1a0081a701030000",
   "x": 26,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 1,
   "headTile": "0xa7",
   "animPhase": 1,
   "ai": 3,
   "aiName": "face_hero",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 0,
   "text": "Brave sir, I hope you've come to help this pitiful town. It was the site of a quiet graveyard before it was decimated by Jashiin."
  },
  {
   "index": 1,
   "raw": "ce0081ab01060006",
   "x": 206,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 1,
   "headTile": "0xab",
   "animPhase": 1,
   "ai": 6,
   "aiName": "bounce_2bit",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 6,
   "text": "Have you seen the strange, bluish-white people in the caverns? They were infected by the Gelroid and now they wander the land like the living dead. To kill them, aim for the head."
  },
  {
   "index": 2,
   "raw": "3500820000010001",
   "x": 53,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 2,
   "headTile": "0x00",
   "animPhase": 0,
   "ai": 1,
   "aiName": "patrol_every_2nd_tick",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 1,
   "text": "If you're going back into the caverns, beware the Gelroid. It's a blue gelatinous substance which will suck the life out of you."
  },
  {
   "index": 3,
   "raw": "470083ab00020004",
   "x": 71,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 3,
   "headTile": "0xab",
   "animPhase": 0,
   "ai": 2,
   "aiName": "patrol_every_4th_tick",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 4,
   "text": "One third of this region is covered with deadly Gelroid. If you're going to continue through the labyrinths, ordinary shoes will not protect you."
  },
  {
   "index": 4,
   "raw": "5600820001030002",
   "x": 86,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 2,
   "headTile": "0x00",
   "animPhase": 1,
   "ai": 3,
   "aiName": "face_hero",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 2,
   "text": "Have you heard of Percel the shoemaker from Herada Town? He made Ruzeria shoes for walking on ice and Pirika shoes for getting by Gelroid, thorns and fire. Those are the only two I know of, but there may have been more."
  },
  {
   "index": 5,
   "raw": "7a00830001050003",
   "x": 122,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 3,
   "headTile": "0x00",
   "animPhase": 1,
   "ai": 5,
   "aiName": "bounce_1bit",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 3,
   "text": "May I confide in you? I was once a spy for Jashiin. I can tell you that the Pirika shoes were put into a box and thrown away somewhere in the Rotten land. You may never find them."
  },
  {
   "index": 6,
   "raw": "a40084ab00020005",
   "x": 164,
   "headRow": 5,
   "facingLeft": true,
   "sprite": 4,
   "headTile": "0xab",
   "animPhase": 0,
   "ai": 2,
   "aiName": "patrol_every_4th_tick",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 5,
   "text": "There is a certain place in the caverns where you can pass through a wall, but only in one direction. My grandfather told me the place is near a green stone slab. There may be other places, but I couldn't say where."
  },
  {
   "index": 7,
   "raw": "c80003ab00010007",
   "x": 200,
   "headRow": 5,
   "facingLeft": false,
   "sprite": 3,
   "headTile": "0xab",
   "animPhase": 0,
   "ai": 1,
   "aiName": "patrol_every_2nd_tick",
   "flags": "0x00",
   "autoTalk": false,
   "blocksHero": false,
   "canTalk": true,
   "textIndex": 7,
   "text": "It seems that Jashiin has stolen many things. The weapon maker is searching for his family crest, the Crest of Glory. If you find it in the caverns, he'll be most happy to have it back."
  }
 ],
 "altNpcArrays": [],
 "texts": [
  {
   "index": 0,
   "text": "Brave sir, I hope you've come to help this pitiful town. It was the site of a quiet graveyard before it was decimated by Jashiin.",
   "controlCodes": [],
   "raw": "4272617665207369722c204920686f706520796f755c766520636f6d6520746f2068656c702074686973207069746966756c20746f776e2e20497420776173207468652073697465206f66206120717569657420677261766579617264206265666f72652069742077617320646563696d61746564206279204a61736869696e2e"
  },
  {
   "index": 1,
   "text": "If you're going back into the caverns, beware the Gelroid. It's a blue gelatinous substance which will suck the life out of you.",
   "controlCodes": [],
   "raw": "496620796f755c726520676f696e67206261636b20696e746f207468652063617665726e732c20626577617265207468652047656c726f69642e2049745c73206120626c75652067656c6174696e6f7573207375627374616e63652077686963682077696c6c207375636b20746865206c696665206f7574206f6620796f752e"
  },
  {
   "index": 2,
   "text": "Have you heard of Percel the shoemaker from Herada Town? He made Ruzeria shoes for walking on ice and Pirika shoes for getting by Gelroid, thorns and fire. Those are the only two I know of, but there may have been more.",
   "controlCodes": [],
   "raw": ""
  },
  {
   "index": 3,
   "text": "May I confide in you? I was once a spy for Jashiin. I can tell you that the Pirika shoes were put into a box and thrown away somewhere in the Rotten land. You may never find them.",
   "controlCodes": [],
   "raw": ""
  },
  {
   "index": 4,
   "text": "One third of this region is covered with deadly Gelroid. If you're going to continue through the labyrinths, ordinary shoes will not protect you.",
   "controlCodes": [],
   "raw": "4f6e65207468697264206f66207468697320726567696f6e20697320636f7665726564207769746820646561646c792047656c726f69642e20496620796f755c726520676f696e6720746f20636f6e74696e7565207468726f75676820746865206c61627972696e7468732c206f7264696e6172792073686f65732077696c6c206e6f742070726f7465637420796f752e"
  },
  {
   "index": 5,
   "text": "There is a certain place in the caverns where you can pass through a wall, but only in one direction. My grandfather told me the place is near a green stone slab. There may be other places, but I couldn't say where.",
   "controlCodes": [],
   "raw": ""
  },
  {
   "index": 6,
   "text": "Have you seen the strange, bluish-white people in the caverns? They were infected by the Gelroid and now they wander the land like the living dead. To kill them, aim for the head.",
   "controlCodes": [],
   "raw": ""
  },
  {
   "index": 7,
   "text": "It seems that Jashiin has stolen many things. The weapon maker is searching for his family crest, the Crest of Glory. If you find it in the caverns, he'll be most happy to have it back.",
   "controlCodes": [],
   "raw": ""
  },
  {
   "index": 8,
   "text": "Those are the Pirika shoes. Go quickly to the abode of Jashiin and finish him off. We will pray for your success and swift return.",
   "controlCodes": [],
   "raw": "54686f7365206172652074686520506972696b612073686f65732e20476f20717569636b6c7920746f207468652061626f6465206f66204a61736869696e20616e642066696e6973682068696d206f66662e2057652077696c6c207072617920666f7220796f7572207375636365737320616e642073776966742072657475726e2e"
  },
  {
   "index": 9,
   "text": "Ah, the Pirika shoes! Forgive me, brave sir. I had no choice. I won't do that kind of thing again.",
   "controlCodes": [],
   "raw": "41682c2074686520506972696b612073686f65732120466f7267697665206d652c206272617665207369722e204920686164206e6f2063686f6963652e204920776f6e5c7420646f2074686174206b696e64206f66207468696e6720616761696e2e"
  },
  {
   "index": 10,
   "text": "Isn't that the Crest of Glory? Please take it quickly to the owner of the weapons store.",
   "controlCodes": [],
   "raw": "49736e5c74207468617420746865204372657374206f6620476c6f72793f20506c656173652074616b6520697420717569636b6c7920746f20746865206f776e6572206f662074686520776561706f6e732073746f72652e"
  },
  {
   "index": 11,
   "text": ". . . . . .",
   "controlCodes": [],
   "raw": "2e202e202e202e202e202e"
  }
 ],
